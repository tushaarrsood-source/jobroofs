      "checkConstraints": {
        "jobs_origin_reference_check": {
          "name": "jobs_origin_reference_check",
          "value": "(\"jobs\".\"listing_origin\" = 'employer_posted' AND \"jobs\".\"employer_submission_id\" IS NOT NULL) OR (\"jobs\".\"listing_origin\" = 'sourced' AND \"jobs\".\"source_id\" IS NOT NULL)"
        },
        "jobs_application_destination_check": {
          "name": "jobs_application_destination_check",
          "value": "(\"jobs\".\"application_method\" = 'email' AND \"jobs\".\"application_email\" IS NOT NULL) OR (\"jobs\".\"application_method\" = 'external_link' AND \"jobs\".\"application_url\" IS NOT NULL) OR (\"jobs\".\"application_method\" = 'not_stated' AND \"jobs\".\"application_email\" IS NULL AND \"jobs\".\"application_url\" IS NULL)"
        },
        "jobs_compensation_range_check": {
          "name": "jobs_compensation_range_check",
          "value": "\"jobs\".\"compensation_amount_maximum\" IS NULL OR \"jobs\".\"compensation_amount_minimum\" IS NULL OR \"jobs\".\"compensation_amount_maximum\" >= \"jobs\".\"compensation_amount_minimum\""
        },
        "jobs_hours_range_check": {
          "name": "jobs_hours_range_check",
          "value": "\"jobs\".\"hours_maximum\" IS NULL OR \"jobs\".\"hours_minimum\" IS NULL OR \"jobs\".\"hours_maximum\" >= \"jobs\".\"hours_minimum\""
        }
      }
