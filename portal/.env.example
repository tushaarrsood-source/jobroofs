# Server-only. Never expose this value to client components.
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Long random value used only by the internal CRM and scheduler.
INGESTION_API_KEY=

# Stripe payment integration (employer self-serve jobs & housing listings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public app URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Configuration (Backend, Storage & Database)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
