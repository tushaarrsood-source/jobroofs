# Server-only. Never expose this value to client components.
FIRECRAWL_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Long random value used only by the internal CRM and scheduler.
INGESTION_API_KEY=

# Stripe payment integration (employer self-serve listings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public app URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
